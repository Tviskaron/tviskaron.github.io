---
import Base from '../layouts/Base.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

const cvPath = path.resolve('src/data/cv.yaml');
const raw = fs.readFileSync(cvPath, 'utf-8');
const data = yaml.load(raw) as any;
const cv = data.cv;

const sections = cv.sections;
const education = sections['Education'] || [];
const experience = sections['Research Experience'] || [];
const skills = sections['Technical Skills'] || [];
const achievements = sections['Achievements & Service'] || [];
const teaching = sections['Teaching'] || [];
const publications = sections['Selected Publications'] || [];

const connections = cv.custom_connections || [];

function formatDate(d: string): string {
  if (!d || d === 'present') return 'Present';
  const date = new Date(d);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

function stripMarkdownBold(s: string): string {
  return s.replace(/\*\*/g, '');
}

function markdownLinkToHtml(s: string): string {
  return s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
}
---

<Base title="Alexey Skrynnik">
  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="#" class="nav-name">{cv.name}</a>
      <div class="nav-links">
        <a href="#experience">Experience</a>
        <a href="#publications">Publications</a>
        <a href="#teaching">Teaching</a>
        <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme"></button>
      </div>
    </div>
  </nav>

  <main class="container">
    <!-- HERO CARD -->
    <section class="hero-card">
      <div class="hero-photo">
        <img src="/profile.jpg" alt="Alexey Skrynnik" width="400" height="400" />
      </div>
      <div class="hero-info">
        <h1>{cv.name}</h1>
        <p class="headline">{cv.headline}</p>
        <p class="location">{cv.location}</p>
        <p class="about-text">
          Senior Research Scientist and Team Lead at AIRI focused on reinforcement learning, multi-agent systems, and LLM/multimodal agents. My recent work spans RL-style tree search for LLM test-time reasoning, foundation-model and learnable approaches to multi-agent pathfinding, and embodied instruction-following agents.
        </p>
        <div class="links">
          <a href={`mailto:${cv.email}`} class="link-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Email
          </a>
          {connections.filter((c: any) => c.placeholder !== 'Website').map((c: any) => (
            <a href={c.url} target="_blank" rel="noopener" class="link-pill">
              {c.placeholder}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="section" id="experience">
      <h2>Research Experience</h2>
      {experience.map((exp: any) => (
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">{exp.position}</h3>
              <p class="card-subtitle">{exp.company}</p>
            </div>
            <div class="card-meta">
              <span class="card-date">{formatDate(exp.start_date)} &mdash; {formatDate(exp.end_date)}</span>
              <span class="card-location">{exp.location}</span>
            </div>
          </div>
          {exp.highlights && (
            <ul class="card-list">
              {exp.highlights.map((h: string) => (
                <li set:html={markdownLinkToHtml(h)} />
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>

    <!-- EDUCATION -->
    <section class="section" id="education">
      <h2>Education</h2>
      <div class="compact-list">
        {education.map((e: any) => (
          <div class="compact-item">
            <span class="compact-label">{e.label}</span>
            <span class="compact-detail">{e.details.replace(/--/g, '\u2013')}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PUBLICATIONS -->
    <section class="section" id="publications">
      <h2>Selected Publications</h2>
      <div class="pub-list">
        {publications.map((pub: any) => (
          <div class="pub">
            <span class="badge">{pub.journal}</span>
            <h3 class="pub-title">
              {pub.url ? (
                <a href={pub.url} target="_blank" rel="noopener">{pub.title}</a>
              ) : (
                pub.title
              )}
            </h3>
            <p class="pub-authors">
              {pub.authors.map((a: string, i: number) => (
                <span>
                  {stripMarkdownBold(a) === 'Alexey Skrynnik' ? (
                    <strong>{stripMarkdownBold(a)}</strong>
                  ) : (
                    stripMarkdownBold(a)
                  )}
                  {i < pub.authors.length - 1 ? ', ' : ''}
                </span>
              ))}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- SKILLS -->
    <section class="section" id="skills">
      <h2>Technical Skills</h2>
      <div class="skills-grid">
        {skills.map((s: any) => (
          <div class="skill-row">
            <span class="skill-label">{s.label}</span>
            <span class="skill-detail">{s.details}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ACHIEVEMENTS -->
    <section class="section" id="achievements">
      <h2>Achievements & Service</h2>
      <ul class="achievements-list">
        {achievements.map((a: any) => (
          <li set:html={markdownLinkToHtml(a.bullet.replace(/--/g, '\u2014'))} />
        ))}
      </ul>
    </section>

    <!-- TEACHING -->
    <section class="section" id="teaching">
      <h2>Teaching</h2>
      <div class="compact-list">
        {teaching.map((t: any) => (
          <div class="compact-item">
            <span class="compact-label">{t.label.replace(/--/g, '\u2013')}</span>
            <span class="compact-detail">{t.details.replace(/--/g, '\u2013')}</span>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <p>&copy; {new Date().getFullYear()} {cv.name}</p>
  </footer>
</Base>

<style>
  /* NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--fg);
  }
  .nav-name:hover { text-decoration: none; }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-links a {
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .nav-links a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .theme-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.15rem;
    padding: 0.25rem;
    line-height: 1;
  }

  /* CONTAINER */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  /* HERO CARD */
  .hero-card {
    margin-top: 2rem;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    background: var(--bg-alt);
    box-shadow: var(--shadow);
  }
  .hero-photo {
    flex-shrink: 0;
  }
  .hero-photo img {
    width: 160px;
    height: 160px;
    border-radius: 10px;
    object-fit: cover;
    display: block;
  }
  .hero-info {
    flex: 1;
    min-width: 0;
  }
  .hero-info h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .headline {
    margin-top: 0.35rem;
    font-size: 1rem;
    color: var(--fg-muted);
  }
  .location {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .about-text {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--fg-muted);
  }
  .links {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg);
    transition: all 0.15s;
  }
  .link-pill:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    text-decoration: none;
  }
  .link-pill svg {
    flex-shrink: 0;
  }

  /* SECTIONS */
  .section {
    margin-top: 2.5rem;
  }
  .section h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* CARDS (experience) */
  .card {
    padding: 1.25rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }
  .card:last-child { border-bottom: none; }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .card-title {
    font-size: 1rem;
    font-weight: 600;
  }
  .card-subtitle {
    font-size: 0.9rem;
    color: var(--fg-muted);
    margin-top: 0.15rem;
  }
  .card-meta {
    text-align: right;
    flex-shrink: 0;
  }
  .card-date {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }
  .card-location {
    display: block;
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .card-list {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
  }
  .card-list li {
    font-size: 0.9rem;
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  /* COMPACT LIST (education, teaching) */
  .compact-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .compact-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .compact-label {
    font-weight: 500;
    font-size: 0.95rem;
  }
  .compact-detail {
    font-size: 0.85rem;
    color: var(--fg-muted);
    text-align: right;
    flex-shrink: 0;
  }

  /* PUBLICATIONS */
  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pub {
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }
  .pub:last-child { border-bottom: none; }
  .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--badge-bg);
    color: var(--badge-fg);
    font-size: 0.7rem;
    font-weight: 600;
    font-family: var(--font-mono);
    border-radius: 4px;
    margin-bottom: 0.35rem;
  }
  .pub-title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .pub-title a {
    color: var(--fg);
  }
  .pub-title a:hover {
    color: var(--accent);
  }
  .pub-authors {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  /* SKILLS */
  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .skill-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .skill-label {
    font-weight: 600;
    font-size: 0.9rem;
    flex-shrink: 0;
    min-width: 160px;
  }
  .skill-detail {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  /* ACHIEVEMENTS */
  .achievements-list {
    padding-left: 1.25rem;
  }
  .achievements-list li {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  /* FOOTER */
  .footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--fg-muted);
    border-top: 1px solid var(--border);
  }

  /* RESPONSIVE */
  @media (max-width: 640px) {
    .hero-card { flex-direction: column; align-items: center; text-align: center; padding: 1.5rem; }
    .hero-photo img { width: 120px; height: 120px; }
    .hero-info h1 { font-size: 1.75rem; }
    .links { justify-content: center; }
    .about-text { text-align: left; }
    .card-header { flex-direction: column; gap: 0.25rem; }
    .card-meta { text-align: left; }
    .compact-item { flex-direction: column; gap: 0.1rem; }
    .compact-detail { text-align: left; }
    .pub { gap: 0.4rem; }
    .skill-row { flex-direction: column; gap: 0.1rem; }
    .skill-label { min-width: 0; }
  }
</style>
